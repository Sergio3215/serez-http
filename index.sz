// serez-http — HTTP/WebSocket server library for Serez-Code
// Version 1.0.0
//
// Usage:
//   import "serez-http"
//
// Main API:
//   App                        ← server class (GET/POST/PUT/delete/ws/addMw/error/listen)
//   WsConn                     ← WebSocket connection (on/send/listen)
//
// Utilities (available after import):
//   parseRequest(raw)          ← parse raw TCP string into request dict
//   matchRoute(pattern, path)  ← route matching with :params
//
// Security built into App (nativo — ver nota de semántica en app.sz):
//   app.cors(origin, methods, headers)       ← CORS headers + preflight OPTIONS 204
//   app.header(key, value)                   ← header global en todas las respuestas
//   app.rateLimitRoute(path, max, win_secs)  ← 429 al superar el límite por ruta
//
// DEPRECADO (roto por semántica de valor — los módulos no comparten estado):
//   corsMiddleware(...)  → usar app.cors(...)
//   _rateLimit(...)      → usar app.rateLimitRoute(...)

import "src/request"
import "src/response"
import "src/router"
import "src/security/rate_limit"
import "src/security/cors"
import "src/ws"
import "src/app"
