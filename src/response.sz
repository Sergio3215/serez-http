// HTTP response builder
//
// NOTA de semántica serez-code: los objetos van por VALOR — un handler que
// recibe `res` muta una COPIA. Eso funciona porque send() escribe al socket
// (efecto externo) y status().header().send() se encadenan sobre la MISMA
// copia. Lo que NO funciona es mutar `res` en un middleware y esperar que el
// handler lo vea: por eso los headers globales (CORS, etc.) los acumula App
// y entran por el constructor (`extra`).

use permissions { Socket }

export public class Response {
    public Response(conn_id, extra) {
        this.conn_id = conn_id
        this.code = 200
        this._extra = extra
        this.sent = false
    }

    public status(code) {
        this.code = code
        return this
    }

    public header(key, value) {
        this._extra.push(key + ": " + value)
        return this
    }

    public cookie(name, value) {
        this._extra.push("Set-Cookie: " + name + "=" + value)
        return this
    }

    public json(obj) {
        let body = JSON.stringify(obj)
        this._send("application/json; charset=utf-8", body)
    }

    public send(data) {
        this._send("text/plain; charset=utf-8", data.toString())
    }

    public redirect(url) {
        this.code = 302
        this._extra.push("Location: " + url)
        this._send("text/plain", "")
    }

    public sendfile(path) {
        let content = File.read(path)
        this._send("application/octet-stream", content)
    }

    public download(path) {
        let parts = path.split("/")
        let fname = parts[parts.length() - 1]
        this._extra.push("Content-Disposition: attachment; filename=\"" + fname + "\"")
        this.sendfile(path)
    }

    public _send(ct, body) {
        if (this.sent) { return }
        this.sent = true
        let st = this._statusText(this.code)
        let r = "HTTP/1.1 " + this.code + " " + st + "\r\n"
        r = r + "Content-Type: " + ct + "\r\n"
        r = r + "Content-Length: " + body.length() + "\r\n"
        r = r + "Connection: close\r\n"
        let i = 0
        while (i < this._extra.length()) {
            r = r + this._extra[i] + "\r\n"
            i = i + 1
        }
        r = r + "\r\n" + body
        Socket.send(this.conn_id, r)
    }

    public _statusText(code) {
        if (code == 200) { return "OK" }
        if (code == 201) { return "Created" }
        if (code == 204) { return "No Content" }
        if (code == 301) { return "Moved Permanently" }
        if (code == 302) { return "Found" }
        if (code == 400) { return "Bad Request" }
        if (code == 401) { return "Unauthorized" }
        if (code == 403) { return "Forbidden" }
        if (code == 404) { return "Not Found" }
        if (code == 405) { return "Method Not Allowed" }
        if (code == 415) { return "Unsupported Media Type" }
        if (code == 429) { return "Too Many Requests" }
        if (code == 500) { return "Internal Server Error" }
        return "Unknown"
    }
}
